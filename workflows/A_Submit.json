    {
      "parameters": {
        "jsCode": "const G_MAP={\n  \"107\":\"G1\",\"108\":\"G1\",\n  \"105\":\"G2\",\"132\":\"G2\",\"133\":\"G2\",\"109\":\"G2\",\"110\":\"G2\",\n  \"101\":\"G3\",\"103\":\"G3\",\"104\":\"G3\",\n  \"131\":\"G4\",\"106\":\"G5\",\"134\":\"G6\",\"102\":\"G7\",\"135\":\"G8\"\n};\nconst CALL_G=new Set([\"G2\",\"G3\",\"G4\",\"G6\",\"G7\"]);\nconst out=[];\nfor(const it of $input.all()){\n  const r=it.json;\n  const code=String(r.on_hold_reason_code||\"\").trim();\n  if(!code||!String(r.image_url_1||\"\").trim()) continue;\n  const g=G_MAP[code];\n  if(!g) continue;\n  const row={\n    row_number:r.row_number,\n    tracking_no:r.tracking_no,\n    onhold_reason_code:code,\n    on_hold_reason_name_th:String(r.on_hold_reason_name_th||\"\"),\n    audit_group:g,\n    image_url_1:r.image_url_1||\"\",\n    image_url_2:r.image_url_2||\"\",\n    image_url_3:r.image_url_3||\"\"\n  };\n  if(CALL_G.has(g)){\n    row.on_hold_date=String(r.on_hold_date||\"\");\n    row.contact_phone_masked=String(r.contact_phone_masked||\"\");\n    row.call_duration_in_sec=String(r.call_duration_in_sec||\"0\");\n  }\n  if(g===\"G8\") row.on_hold_date=String(r.on_hold_date||\"\");\n  out.push({json:row});\n}\nreturn out;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -608,
        304
      ],
      "id": "08cafe61-0afb-483a-a6d0-413639efd7db",
      "name": "Filter + Classify"
    },
    {
      "parameters": {
        "jsCode": "const CHUNK_DEFAULT=1000;\nconst CHUNK_HYBRID_CALL=150; // hybrid classify+ascall+aschat (2026-07-07) triples embedded image bytes per row for these types -> smaller chunks to stay under Compass's 200MB/file limit and n8n worker capacity\nconst HYBRID_CALL_TYPES=new Set([\"call\",\"call_no_ans\",\"call_loc\",\"call_veh\",\"call_ext\"]);\nconst BT={G1:\"ocr\",G2:\"call\",G3:\"call_loc\",G4:\"call_veh\",G5:\"ext\",G6:\"call_ext\",G7:\"call_no_ans\",G8:\"fuel\"};\nconst byG={};\nfor(const it of $input.all()){\n  const g=it.json.audit_group;\n  if(!byG[g]) byG[g]=[];\n  byG[g].push(it.json);\n}\nconst out=[];\nfor(const [g,rows] of Object.entries(byG)){\n  const bt=BT[g]||g;\n  const chunkSize = HYBRID_CALL_TYPES.has(bt) ? CHUNK_HYBRID_CALL : CHUNK_DEFAULT;\n  for(let i=0;i<rows.length;i+=chunkSize)\n    out.push({json:{batch_type:bt, chunk_index:Math.floor(i/chunkSize), rows:rows.slice(i,i+chunkSize)}});\n}\nreturn out;"
      },
